---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message envoy\u00e9 \u2014 Claire Clavel, Psychologue Clinicienne"
  description="Votre message a bien \u00e9t\u00e9 envoy\u00e9."
  noindex={true}
>
  <main id="main-content">
    <div class="merci-content container">
      <h1>Merci pour votre message</h1>
      <p>Votre demande a bien \u00e9t\u00e9 envoy\u00e9e. Je vous r\u00e9pondrai dans les meilleurs d\u00e9lais, g\u00e9n\u00e9ralement sous 48 heures.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Retour \u00e0 l'accueil</a>
        <a href="https://www.doctolib.fr/psychologue/seichamps/claire-clavel"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-ghost" style="border-color: var(--clr-primary); color: var(--clr-primary);">
          Prendre rendez-vous sur Doctolib
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
