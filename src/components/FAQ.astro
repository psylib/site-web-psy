---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item, i) => (
    <details class="faq-item" name="faq">
      <summary class="faq-question">
        <span>{item.question}</span>
        <svg class="faq-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 7.5l5 5 5-5"/>
        </svg>
      </summary>
      <div class="faq-answer">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
