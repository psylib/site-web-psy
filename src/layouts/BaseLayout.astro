---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const {
  title,
  description,
  ogImage = 'https://www.claire-clavel-psychologue.fr/images/cabinet-bureau.webp',
  ogType = 'website',
  canonical,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const siteUrl = 'https://www.claire-clavel-psychologue.fr';
const pageCanonical = canonical || new URL(Astro.url.pathname, siteUrl).href;

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Claire Clavel \u2014 Psychologue Clinicienne",
  "url": siteUrl + "/",
  "description": "Site officiel de Claire Clavel, psychologue clinicienne \u00e0 Seichamps (54280), pr\u00e8s de Nancy.",
  "inLanguage": "fr",
  "publisher": { "@id": siteUrl + "/#practice" }
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow" />
  }
  <link rel="canonical" href={pageCanonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageCanonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Claire Clavel Psychologue" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />

  <!-- JSON-LD WebSite (always present) -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

  <!-- Additional JSON-LD -->
  {jsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">Aller au contenu principal</a>
  <slot />
</body>
</html>
